  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
